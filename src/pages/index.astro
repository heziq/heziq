---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { projects } from '../lib/projects';
import { categories, categorySlug, href, newestFirst } from '../lib/site';

const notes = (await getCollection('notes')).sort(newestFirst);
const recentNotes = notes.slice(0, 3);
---
<BaseLayout>
  <div class="shell home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Jessica Yang / portfolio & notes</p>
        <h1 id="hero-title">Hi, welcome.</h1>
        <p class="hero-intro">I’m Jessica, an MS Computer Science student at UC San Diego. I work across AI agents, LLM systems, software engineering, graphics, and computer vision.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={href('projects/')}>View projects <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href={href('notes/')}>Read notes <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-index" aria-label="Personal information">
        <div class="index-head"><span>PROFILE</span><span>JY / 2026</span></div>
        <div class="index-rule"></div>
        <dl class="profile-details">
          <div><dt>Based in</dt><dd>San Diego, CA</dd></div>
          <div><dt>Education</dt><dd>UC San Diego<br />MS Computer Science</dd></div>
        </dl>
        <a class="profile-link" href="https://github.com/heziq"><span>GitHub</span><span>github.com/heziq ↗</span></a>
      </div>
    </section>

    <section class="section-block home-categories" aria-labelledby="browse-title">
      <div class="section-heading"><div><p class="eyebrow">Explore the notebook</p><h2 id="browse-title">Browse by subject</h2></div><a class="text-link" href={href('notes/')}>All notes <span aria-hidden="true">↗</span></a></div>
      <div class="category-grid">{categories.map((category) => <a class="category-card" href={href(`notes/category/${categorySlug(category)}/`)}><span>{category}</span><small>{notes.filter((note) => note.data.category === category).length} notes</small><b aria-hidden="true">↗</b></a>)}</div>
    </section>

    <section class="section-block" aria-labelledby="projects-title">
      <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2 id="projects-title">Projects</h2></div><a class="text-link" href={href('projects/')}>All projects <span aria-hidden="true">↗</span></a></div>
      <div class="project-grid">{projects.slice(0, 3).map((project) => <ProjectCard project={project} />)}</div>
    </section>

    <section class="section-block notes-preview" aria-labelledby="notes-title">
      <div class="section-heading"><div><p class="eyebrow">From the notebook</p><h2 id="notes-title">Recent notes</h2></div><a class="text-link" href={href('notes/')}>View all notes <span aria-hidden="true">↗</span></a></div>
      <div class="note-grid">{recentNotes.map((note) => <NoteCard note={note} />)}</div>
    </section>

  </div>
</BaseLayout>
