---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import CoastalStudy from '../components/CoastalStudy.astro';
import { projects } from '../lib/projects';
import { categories, categorySlug, href, newestFirst } from '../lib/site';

const notes = (await getCollection('notes')).sort(newestFirst);
const recentNotes = notes.slice(0, 3);
---
<BaseLayout>
  <div class="shell home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Jessica Yang <span aria-hidden="true">/</span> San Diego, California</p>
        <h1 id="hero-title">Hi, I'm <em>Jessica.</em></h1>
        <p class="hero-intro">I’m an MS Computer Science student at UC San Diego, working across AI agents, LLM systems, software engineering, graphics, and computer vision.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={href('projects/')}>View projects <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href={href('notes/')}>Read notes <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <CoastalStudy />
    </section>
    <div class="home-context"><span>MS Computer Science · UC San Diego</span><a href="https://github.com/heziq">Find me on GitHub <span aria-hidden="true">↗</span></a></div>

    <section class="section-block" aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">Selected projects</h2><a class="text-link" href={href('projects/')}>All projects <span aria-hidden="true">↗</span></a></div>
      <div class="project-grid">{projects.slice(0, 3).map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    </section>

    <section class="section-block home-categories" aria-labelledby="browse-title">
      <div class="section-heading"><h2 id="browse-title">Browse the notebook</h2><a class="text-link" href={href('notes/')}>All notes <span aria-hidden="true">↗</span></a></div>
      <div class="category-grid note-categories">{categories.map((category) => <a class="category-card" href={href(`notes/category/${categorySlug(category)}/`)}><span>{category}</span><small>{notes.filter((note) => note.data.category === category).length} notes</small><b aria-hidden="true">↗</b></a>)}</div>
    </section>

    <section class="section-block notes-preview" aria-labelledby="notes-title">
      <div class="section-heading"><h2 id="notes-title">Recently noted</h2><a class="text-link" href={href('notes/')}>View all notes <span aria-hidden="true">↗</span></a></div>
      <div class="note-grid">{recentNotes.map((note) => <NoteCard note={note} />)}</div>
    </section>

  </div>
</BaseLayout>
