---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesSidebar from '../../components/NotesSidebar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { categorySlug, formatDate, href, newestFirst, tagSlug } from '../../lib/site';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note, notes } }));
}

const { note, notes } = Astro.props as { note: CollectionEntry<'notes'>; notes: CollectionEntry<'notes'>[] };
const { Content, headings } = await render(note);
const ordered = [...notes].sort(newestFirst);
const position = ordered.findIndex((item) => item.id === note.id);
const previous = ordered[position + 1];
const next = ordered[position - 1];
---
<BaseLayout title={note.data.title} description={note.data.description} type="article">
  <div class="shell note-page">
    <div class="note-breadcrumb"><a href={href('notes/')}>Notes</a><span>/</span><a href={href(`notes/category/${categorySlug(note.data.category)}/`)}>{note.data.category}</a></div>
    <div class="note-layout">
      <NotesSidebar notes={notes.sort(newestFirst)} currentId={note.id} />
      <article class="note-article">
        <header class="note-header"><p class="eyebrow">{note.data.category}</p><h1>{note.data.title}</h1><p class="note-description">{note.data.description}</p><div class="note-meta"><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>{note.data.tags.length > 0 && <><span aria-hidden="true">·</span><span>Tags: {note.data.tags.map((tag, index) => <Fragment>{index > 0 && ', '}<a href={href(`notes/tag/${tagSlug(tag)}/`)}>{tag}</a></Fragment>)}</span></>}</div></header>
        <div class="prose"><Content /></div>
        <nav class="article-end" aria-label="More notes">
          {previous && <a href={href(`notes/${previous.id}/`)}><small>Older note</small><span>← {previous.data.title}</span></a>}
          {next && <a href={href(`notes/${next.id}/`)}><small>Newer note</small><span>{next.data.title} →</span></a>}
          <a href={href('notes/')}><small>Archive</small><span>All notes ↗</span></a>
        </nav>
      </article>
      <TableOfContents headings={headings} />
    </div>
  </div>
</BaseLayout>
