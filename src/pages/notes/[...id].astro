---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesSidebar from '../../components/NotesSidebar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { categorySlug, formatDate, href, newestFirst, tagSlug } from '../../lib/site';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note, notes } }));
}

const { note, notes } = Astro.props as { note: CollectionEntry<'notes'>; notes: CollectionEntry<'notes'>[] };
const { Content, headings } = await render(note);
---
<BaseLayout title={note.data.title} description={note.data.description} type="article">
  <div class="shell note-page">
    <div class="note-breadcrumb"><a href={href('notes/')}>Writing</a><span>/</span><a href={href(`notes/category/${categorySlug(note.data.category)}/`)}>{note.data.category}</a></div>
    <div class="note-layout">
      <NotesSidebar notes={notes.sort(newestFirst)} currentId={note.id} />
      <article class="note-article">
        <header class="note-header"><p class="eyebrow">{note.data.category}</p><h1>{note.data.title}</h1><p class="note-description">{note.data.description}</p><div class="note-meta"><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>{note.data.topics.length > 0 && <><span aria-hidden="true">·</span><span>Topics: {note.data.topics.map((topic, index) => <Fragment>{index > 0 && ', '}<a href={href(`notes/tag/${tagSlug(topic)}/`)}>{topic}</a></Fragment>)}</span></>}{note.data.formats.length > 0 && <><span aria-hidden="true">·</span><span>Formats: {note.data.formats.map((format, index) => <Fragment>{index > 0 && ', '}<a href={href(`notes/format/${tagSlug(format)}/`)}>{format}</a></Fragment>)}</span></>}</div></header>
        <div class="prose"><Content /></div>
        <div class="article-end"><a class="text-link" href={href('notes/')}>← All writing</a></div>
      </article>
      <TableOfContents headings={headings} />
    </div>
  </div>
</BaseLayout>
