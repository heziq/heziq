---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NoteCard from '../../../components/NoteCard.astro';
import { categories, categorySlug, href, newestFirst } from '../../../lib/site';

export function getStaticPaths() {
  return [...new Set([...categories, 'Systems', 'AI / Agents', 'Research', 'Graphics / CV', 'Tech Notes', 'Other'])].map((category) => ({ params: { category: categorySlug(category) }, props: { category } }));
}
const { category } = Astro.props as { category: string };
const isCategory = categories.some((item) => item === category);
const notes = (await getCollection('notes')).filter((note) => category === 'Tech Notes' || (isCategory ? note.data.category === category : note.data.tags.includes(category))).sort(newestFirst);
---
<BaseLayout title={`${category} notes`} description={`${category} notes by Jessica Yang.`}>
  <div class="shell page"><div class="note-breadcrumb"><a href={href('notes/')}>Notes</a><span>/</span><span>{category}</span></div><header class="page-heading compact-heading"><p class="eyebrow">{isCategory ? 'Category' : 'Archive'} / {notes.length} notes</p><h1>{category}</h1></header>{notes.length ? <div class="note-grid">{notes.map((note) => <NoteCard note={note} />)}</div> : <div class="quiet-panel">No notes here yet. <a href={href('notes/')}>Browse all notes ↗</a></div>}</div>
</BaseLayout>
