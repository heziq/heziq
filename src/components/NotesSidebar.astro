---
import type { CollectionEntry } from 'astro:content';
import { categories, categorySlug, href, noteHref } from '../lib/site';
const { notes, currentId } = Astro.props as { notes: CollectionEntry<'notes'>[]; currentId?: string };
---
<aside class="notes-sidebar" aria-label="Writing by section">
  <div class="sidebar-heading">Browse writing</div>
  {categories.map((category) => {
    const items = notes.filter((note) => note.data.category === category);
    return <div class="sidebar-group">
      <a class="sidebar-category" href={href(`notes/category/${categorySlug(category)}/`)}>{category} <span>{items.length}</span></a>
      {items.length > 0 && <ul>{items.map((note) => <li><a href={noteHref(note)} aria-current={currentId === note.id ? 'page' : undefined}>{note.data.title}</a></li>)}</ul>}
    </div>;
  })}
</aside>
