---
import { href } from '../lib/site';
---
<div class="notes-search" data-index={href('search-index.json')}>
  <label for="notes-query">Search notes</label>
  <input id="notes-query" type="search" placeholder="Search titles, topics, or article text" autocomplete="off" aria-controls="search-results" />
  <p class="search-hint">Search across notes. Press ⌘K or Ctrl K to focus.</p>
  <div id="search-results" class="search-results" aria-live="polite" hidden></div>
</div>
<script>
  type Result = { title: string; description: string; category: string; tags: string[]; url: string; text: string };
  const root = document.querySelector<HTMLElement>('.notes-search');
  const input = root?.querySelector<HTMLInputElement>('input');
  const results = root?.querySelector<HTMLElement>('.search-results');
  let index: Result[] | undefined;
  const load = async () => {
    if (index) return index;
    const response = await fetch(root!.dataset.index!);
    if (!response.ok) throw new Error('Search index unavailable');
    index = await response.json() as Result[];
    return index;
  };
  const search = async () => {
    if (!input || !results) return;
    const query = input.value.trim().toLocaleLowerCase();
    results.replaceChildren();
    results.hidden = !query;
    if (!query) return;
    results.textContent = 'Searching…';
    try {
      const terms = query.split(/\s+/);
      const matches = (await load()).filter((item) => terms.every((term) => `${item.title} ${item.description} ${item.category} ${item.tags.join(' ')} ${item.text}`.toLocaleLowerCase().includes(term))).slice(0, 20);
      results.replaceChildren();
      if (!matches.length) { results.textContent = 'No matching notes. Try another topic or keyword.'; return; }
      const list = document.createElement('ul');
      for (const item of matches) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.title;
        const meta = document.createElement('span');
        meta.textContent = `${item.category} · ${item.description}`;
        li.append(link, meta);
        list.append(li);
      }
      results.append(list);
    } catch { results.textContent = 'Search is unavailable. Browse the notes below instead.'; }
  };
  input?.addEventListener('input', search);
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); input?.focus(); }
  });
</script>
