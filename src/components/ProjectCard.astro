---
import type { Project } from '../lib/projects';
import { href } from '../lib/site';
const { project } = Astro.props as { project: Project };
---
<article class="project-card">
  {project.image && <img src={href(project.image)} alt="" loading="lazy" />}
  <div class="project-body">
    <div class="project-top"><span class="project-type">Selected work</span><span aria-hidden="true">↗</span></div>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
    {(project.detail || project.github) && <a class="card-link" href={project.detail ? href(project.detail) : project.github} aria-label={`View ${project.title}`}>View project <span aria-hidden="true">↗</span></a>}
  </div>
</article>
