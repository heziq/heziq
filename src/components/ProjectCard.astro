---
import type { Project } from '../lib/projects';
import { href } from '../lib/site';
const { project, index = 0 } = Astro.props as { project: Project; index?: number };
---
<article class="project-card">
  <div class:list={['project-visual', `visual-${index % 4}`]}>
    {project.image ? <img src={href(project.image)} alt={`${project.title} preview`} loading="lazy" /> : <div class="visual-art" aria-hidden="true"><span></span><span></span><span></span><span></span></div>}
    <span class="visual-caption">{project.tags[0]}</span>
  </div>
  <div class="project-body">
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
    {(project.detail || project.github) && <a class="card-link" href={project.detail ? href(project.detail) : project.github} aria-label={`View ${project.title}`}>View project <span aria-hidden="true">↗</span></a>}
  </div>
</article>
